# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/nexus_saas

# ── Auth (kept identical to the previous Next.js/jose setup
#     so already-issued cookies stay valid) ────────────────
JWT_SECRET=nexussoft-dev-secret-change-in-production
JWT_ISSUER=nexussoft
JWT_ACCESS_AUDIENCE=nexussoft-api
JWT_REFRESH_AUDIENCE=nexussoft-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ── Cron / scheduled jobs ────────────────────────────────
# Master switch for the in-process node-cron scheduler
ENABLE_CRON=true
# Timezone used by cron expressions
CRON_TZ=Asia/Karachi
# Shared secret that also protects the manual POST /api/gym/cron/daily trigger
CRON_SECRET=change-this-cron-secret

# ── Seed ─────────────────────────────────────────────────
DEMO_PASSWORD=password123
