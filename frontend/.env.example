# ── Frontend (Next.js) — set these in Vercel Project Settings -> Environment Variables ──

# MUST equal the backend JWT_SECRET (Render). The middleware verifies the
# access_token cookie the backend issues.
JWT_SECRET=change-me-to-match-backend

# Public URL of this frontend deployment.
NEXT_PUBLIC_APP_URL=https://sass-software.vercel.app

# Backend base URL — next.config.ts rewrites /api/* to `${BACKEND_URL}/api/*`.
# Point this at your Render backend. Needed at BUILD time on Vercel.
BACKEND_URL=https://sass-backend.onrender.com
